{
  "name": "mmmis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Military Mess Management Information System",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.mjs",
    "db:types": "supabase gen types typescript --linked > src/types/database.generated.ts",
    "fn:deploy": "node scripts/deploy-functions.mjs",
    "backup:verify": "tsx scripts/backup-verify.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
