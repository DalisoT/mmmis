# =============================================================================
# MMMIS environment variables
# =============================================================================
# Vite reads variables prefixed with VITE_ from this file at build time.
# Copy to .env.local for local dev; for production set them in Vercel.
#
# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VAPID public key for Web Push (required for push notifications)
# Generate a pair with:  npx web-push generate-vapid-keys
# Then set the matching VAPID_PRIVATE_KEY + VAPID_SUBJECT as Supabase
# Edge Function secrets so push-dispatch can sign messages.
VITE_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Operations tooling — set these locally only. Do NOT commit real values.
# See scripts/migrate.mjs, scripts/deploy-functions.mjs, scripts/backup-verify.ts.
# -----------------------------------------------------------------------------

# Target Supabase project ref. Defaults to gkegnmshivmgqhenqkzr for this
# repository when unset. Required as CONFIRM_SUPABASE_PROJECT_REF when running
# the migration / Edge Function deployers with --execute.
SUPABASE_PROJECT_REF=gkegnmshivmgqhenqkzr

# Direct Postgres connection string. NEVER commit. Used by docs/BACKUP_RESTORE.md
# and by the backup verifier when ALLOW_LIVE_BACKUP_VERIFY=true is set.
# Example format: postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Preferred verifier target — a scratch database after restoring a dump.
# When set, npm run backup:verify uses this URL without the live-DB safety
# flag. Leave blank if you only intend to verify the live database.
BACKUP_VERIFY_DB_URL=
