# =============================================================================
# MMMIS environment variables
# =============================================================================
# Vite reads variables prefixed with VITE_ from this file at build time.
# Copy to .env.local for local dev; for production set them in Vercel.
#
# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VAPID public key for Web Push (required for push notifications)
# Generate a pair with:  npx web-push generate-vapid-keys
# Then set the matching VAPID_PRIVATE_KEY + VAPID_SUBJECT as Supabase
# Edge Function secrets so push-dispatch can sign messages.
VITE_VAPID_PUBLIC_KEY=
