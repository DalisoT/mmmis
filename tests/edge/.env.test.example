# Copy to .env.test and fill in.
# Source it before running run.sh: `export $(grep -v '^#' .env.test | xargs)`
# Or use a tool like `direnv` / `dotenv`.

# Supabase project URL (no trailing slash).
SUPABASE_URL=https://gkegnmshivmgqhenqkzr.supabase.co

# Project anon key (Settings -> API -> Project API keys -> anon / public).
SUPABASE_ANON_KEY=eyJhbGciOi...

# JWT for an active administrator. Get from the SPA's devtools:
#   supabase.auth.getSession().then(s => console.log(s.data.session.access_token))
# while signed in as an administrator.
ADMIN_JWT=

# JWT for an active member (not staff). Same trick as ADMIN_JWT.
MEMBER_JWT=

# Credentials matching MEMBER_JWT's user. Used for the chit-authorize and
# set-member-email happy-path tests.
BUYER_EMAIL=
BUYER_PASSWORD=

# (Optional) id of a chit_authorization_requests row with status='pending'
# and whose member_id matches MEMBER_JWT's user. Create one with:
#   insert into chit_authorization_requests
#     (member_id, created_by, cart, total_amount, status)
#   values
#     ((select user_id from public.members where ...), auth.uid(),
#      '[{"product_id":"...","quantity":1,"unit_price":1.00}]'::jsonb,
#      1.00, 'pending');
# If unset, chit-authorize happy-path and wrong-password tests are SKIPped.
REQUEST_ID=